# Variables read by the worker (see deploy/compose.yml). Copy to .env, which git ignores.
# Service credential (SERVICE role), issued by the identity service; never versioned.
SERVICE_TOKEN=<service-token-with-SERVICE-role>

# How often each job runs, and how much it does per run (ISO-8601 durations/periods).
EXPIRE_EVERY=PT10M
PENDING_TTL=P3D
CONTROLS_EVERY=PT6H
CONTROL_MAX_AGE=P12M
BATCH_SIZE=50
RUN_TIMEOUT=PT2M
HTTP_TIMEOUT=PT5S
HTTP_ATTEMPTS=3
